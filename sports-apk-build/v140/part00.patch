+    private fun titleListRow(article: Article): View = LinearLayout(this).apply {
+        orientation = LinearLayout.HORIZONTAL
+        gravity = Gravity.CENTER_VERTICAL
+        setPadding(dp(14), dp(11), dp(14), dp(11))
+        background = rounded(SURFACE, dp(15).toFloat(), BORDER)
+        elevation = dp(1).toFloat()
+        addView(TextView(context).apply {
+            text = article.title
+            textSize = 16f
+            setTypeface(typeface, Typeface.BOLD)
+            setTextColor(Color.parseColor(TEXT))
+            gravity = Gravity.RIGHT or Gravity.CENTER_VERTICAL
+            textDirection = View.TEXT_DIRECTION_RTL
+            maxLines = 2
+        }, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
+        if (article.favorite) addView(TextView(context).apply {
+            text = "★"
+            textSize = 17f
+            setTextColor(Color.parseColor(GOLD))
+            gravity = Gravity.CENTER
+        }, LinearLayout.LayoutParams(dp(30), dp(34)).apply { marginStart = dp(6) })
+        addView(TextView(context).apply {
+            text = "‹"
+            textSize = 25f
+            setTextColor(Color.parseColor(GREEN))
+            gravity = Gravity.CENTER
+        }, LinearLayout.LayoutParams(dp(28), dp(36)).apply { marginStart = dp(3) })
+        setOnClickListener { showArticle(article.id) }
+    }
+
+    private fun articleBodySections(body: String): View = LinearLayout(this).apply {
+        orientation = LinearLayout.VERTICAL
+        val chunks = body.trim().split(Regex("\\n\\s*\\n")).map { it.trim() }.filter { it.isNotBlank() }
+        val defaultTitles = listOf("نبذة", "أهم المعلومات", "المهارات والقواعد", "الفوائد والسلامة", "معلومات إضافية")
+        chunks.forEachIndexed { index, raw ->
+            val lines = raw.lines()
+            val explicitHeading = lines.firstOrNull()?.trim()?.takeIf { it.startsWith("## ") }?.removePrefix("## ")?.trim()
+            val paragraph = if (explicitHeading != null) lines.drop(1).joinToString("\n").trim() else raw
+            val heading = explicitHeading ?: defaultTitles.getOrElse(index) { "معلومات إضافية" }
+            if (paragraph.isBlank()) return@forEachIndexed
+            if (index > 0) addView(View(context).apply { setBackgroundColor(Color.parseColor("#EEF2F0")) }, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(1)).apply { topMargin = dp(14); bottomMargin = dp(13) })
+            addView(TextView(context).apply {
+                text = heading
+                textSize = 16f
+                setTypeface(typeface, Typeface.BOLD)
+                setTextColor(Color.parseColor(GREEN))
+                gravity = Gravity.RIGHT
+                textDirection = View.TEXT_DIRECTION_RTL
+            })
+            addView(TextView(context).apply {
+                text = paragraph
+                textSize = 17f
+                setTextColor(Color.parseColor(TEXT))
+                setLineSpacing(dp(5).toFloat(), 1.13f)
+                setTextIsSelectable(true)
+                gravity = Gravity.RIGHT
+                textDirection = View.TEXT_DIRECTION_RTL
+            }, margin(top = 7))
+        }
+    }
+
     private fun articleCard(article: Article): View = LinearLayout(this).apply {
         orientation = LinearLayout.VERTICAL
         setPadding(dp(16), dp(15), dp(16), dp(14))
         background = rounded(SURFACE, dp(19).toFloat(), BORDER)
         elevation = dp(1).toFloat()

         addView(LinearLayout(context).apply {
             orientation = LinearLayout.HORIZONTAL
             gravity = Gravity.CENTER_VERTICAL
             addView(TextView(context).apply {
                 text = article.categoryName.ifBlank { "غير مصنف" }
                 textSize = 11.5f
                 setTypeface(typeface, Typeface.BOLD)
                 setTextColor(Color.parseColor(GREEN))
                 setPadding(dp(10), dp(4), dp(10), dp(4))
                 background = rounded(SOFT_GREEN, dp(12).toFloat())
             })
             addView(Space(context), LinearLayout.LayoutParams(0, 1, 1f))
             if (article.favorite) addView(TextView(context).apply {
                 text = "★"
                 textSize = 19f
                 setTextColor(Color.parseColor(GOLD))
                 gravity = Gravity.CENTER
             })
